{
	"name": "@hyzek/toucan-env",
	"version": "23.0.0",
	"description": "Remote execution environments for Toucan Durable: a small daemon deployed over SSH and its ExecutionEnv client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"bin",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"build:daemon": "cargo build --manifest-path daemon/Cargo.toml --locked",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"durable-execution",
		"agents",
		"ssh",
		"remote"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyzek/toucan.git",
		"directory": "packages/env"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@hyzek/chord": "23.0.0",
		"@hyzek/toucan-durable": "23.0.0"
	},
	"devDependencies": {
		"vitest": "4.1.12"
	}
}
